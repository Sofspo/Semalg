read_text <- function(file_path) {
# Import text (one diary entry per row)
text_data <- read.delim(
file_path,
header = FALSE,
sep = "\t",
quote = "",
fill = TRUE
)
# Extract all text and combine into one character vector
text <- unlist(text_data, use.names = FALSE)
# Convert to lowercase
text <- tolower(text)
# Remove punctuation
text <- gsub("[.,;]", "", text)
# Split into individual words
words <- unlist(strsplit(text, split = "\\s+"))
return(words)
}
negative_words <- c(
"heavy", "trapped", "fatigue", "restless", "frustrating",
"frustrated", "angry", "stress", "anxious",
"nause*", "pain*", "unhappy"
)
# Positive words
positive_words <- c(
"hope", "good", "great", "wonderful", "enjoy",
"excited", "relaxed", "love", "energy", "energ*"
)
test_words <- c("nauseous", "nauseated", "happy")
compare_words(test_words, c("nause*"))
compare_words(words, negative_words)
compare_words(words, positive_words)
# Negative words
negative_words <- c(
"heavy", "trapped", "fatigue", "restless",
"frustrat*", "force*", "stress*", "anxious",
"tired", "sad", "pain*", "unhappy",
"headache", "appetite"
)
# Positive words
positive_words <- c(
"hope*", "great", "wonderful", "enjoy*",
"excit*", "relax*", "love", "energy",
"happy", "good"
)
# Negative words
negative_words <- c(
"heavy", "trapped", "fatigue", "restless", "frustrat*",
"force*", "stress", "anxious",
"nause*", "pain*", "unhappy"
)
# Positive words
positive_words <- c(
"hope", "dear", "great", "wonderful", "enjoy*",
"excited", "relaxed", "love", "energy", "energ*"
)
usethis::use_r("sentiment_score")
sentiment_score <- function(document_words, positive_words, negative_words) {
positive_count <- compare_words(document_words, positive_words)
negative_count <- compare_words(document_words, negative_words)
ratio <- if (negative_count == 0) {
NA_real_
} else {
positive_count / negative_count
}
return(list(
positive_count = positive_count,
negative_count = negative_count,
positive_negative_ratio = ratio
))
}
devtools::load_all()
sentiment_score(words, positive_words, negative_words)
sentiment_score
