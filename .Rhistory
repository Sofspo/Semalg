compare_words <- function(document_words, word_list) {
matches <- 0
for (word in word_list) {
if (endsWith(word, "*")) {
prefix <- sub("\\*$", "", word)
matches <- matches + sum(startsWith(document_words, prefix))
} else {
matches <- matches + sum(document_words == word)
}
}
return(matches)
}
return(matches)
